@{
    ViewData["Title"] = "Dependency Injection Demo";
}

<h2>Dependency Injection Lifetimes Demonstration</h2>

<table class="table table-bordered mt-4">
    <thead>
        <tr>
            <th>Lifetime</th>
            <th>Instance 1 GUID</th>
            <th>Instance 2 GUID</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><strong>Transient</strong></td>
            <td>@ViewBag.Transient1</td>
            <td>@ViewBag.Transient2</td>
        </tr>
        <tr>
            <td><strong>Scoped</strong></td>
            <td>@ViewBag.Scoped1</td>
            <td>@ViewBag.Scoped2</td>
        </tr>
        <tr>
            <td><strong>Singleton</strong></td>
            <td>@ViewBag.Singleton1</td>
            <td>@ViewBag.Singleton2</td>
        </tr>
    </tbody>
</table>